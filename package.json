{
  "name": "vinodex",
  "private": true,
  "version": "0.6.62",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings=22",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "export:wine:excel": "ts-node --esm scripts/exportWineEntriesToExcel.ts",
    "build:wine:json": "ts-node --esm scripts/convertExcelToJson.ts",
    "build:encyclopedia": "ts-node --esm scripts/cleanEncyclopediaText.ts",
    "build:encyclopedia:reference": "ts-node --esm scripts/buildEncyclopediaReference.ts",
    "check:refs": "esbuild scripts/find-missing-refs.ts --bundle --platform=node --format=esm --log-level=error | node --input-type=module",
    "check:budget": "esbuild scripts/check-budget.ts --bundle --platform=node --format=esm --log-level=error | node --input-type=module",
    "release": "esbuild scripts/release.ts --bundle --platform=node --format=esm --log-level=error | node --input-type=module -",
    "og:manifest": "esbuild scripts/og-manifest.ts --bundle --platform=node --format=esm --log-level=error | node --input-type=module",
    "prerender:og": "esbuild scripts/prerender-og.ts --bundle --platform=node --format=esm --log-level=error | node --input-type=module",
    "postbuild": "npm run prerender:og",
    "test:e2e": "playwright test",
    "test:e2e:shots": "playwright test screenshots.spec.ts",
    "test:cross": "playwright test --config=playwright.cross.config.ts smoke.spec.ts site.spec.ts walkthrough.spec.ts",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:refs && npm run check:budget && npm run test:e2e"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.3",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
}
